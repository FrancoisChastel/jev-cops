{
  "name": "@jev-cops/adapter-claude-code",
  "version": "0.1.0",
  "description": "cops-hook, the jev-cops command hook for Claude Code: forwards hook events to copsd and maps verdicts back, failing closed",
  "keywords": [
    "jev-cops",
    "coding-agents",
    "ai-agents",
    "agent-security",
    "guardrails",
    "bun",
    "claude-code",
    "hooks",
    "adapter"
  ],
  "homepage": "https://github.com/FrancoisChastel/jev-cops#readme",
  "bugs": {
    "url": "https://github.com/FrancoisChastel/jev-cops/issues"
  },
  "license": "Apache-2.0",
  "author": "François Chastel (https://github.com/FrancoisChastel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-cops.git",
    "directory": "adapters/claude-code"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cops-hook": "./src/hook-main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./process": "./src/process.ts",
    "./canary": "./src/canary.ts",
    "./install": "./src/install.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/hook-main.ts"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@jev-cops/core": "workspace:*",
    "@jev-cops/daemon": "workspace:*",
    "zod": "^4.6.5"
  }
}
