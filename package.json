{
  "name": "jev-cops-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Harness-side judge that scores agent tool calls in context and returns graduated verdicts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-cops.git"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "policies"
  ],
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "lint": "bun x biome check .",
    "lint:fix": "bun x biome check --write .",
    "check": "bun run lint && bun run typecheck && bun test",
    "gate": "bun packages/cli/src/main.ts test policies",
    "build:daemon": "bun build --compile packages/daemon/src/main.ts --outfile dist/copsd",
    "build:cli": "bun build --compile packages/cli/src/main.ts --outfile dist/cops",
    "build:hook": "bun build --compile adapters/claude-code/src/hook-main.ts --outfile dist/cops-hook",
    "build": "bun run build:daemon && bun run build:cli && bun run build:hook",
    "pack:smoke": "bun scripts/pack-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
