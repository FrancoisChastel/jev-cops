{
  "name": "@jev-cops/policies",
  "version": "0.1.0",
  "description": "The jev-cops starter policy set with its fixtures: config-tamper, default-branch-guard, exfil-after-secrets, off-repo-write, opaque-exec, tainted-destructive",
  "keywords": [
    "jev-cops",
    "coding-agents",
    "ai-agents",
    "agent-security",
    "guardrails",
    "bun",
    "policies",
    "policy-as-code",
    "claude-code"
  ],
  "homepage": "https://github.com/FrancoisChastel/jev-cops#readme",
  "bugs": {
    "url": "https://github.com/FrancoisChastel/jev-cops/issues"
  },
  "license": "Apache-2.0",
  "author": "François Chastel (https://github.com/FrancoisChastel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-cops.git",
    "directory": "policies"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "_lib",
    "!_lib/**/*.test.ts",
    "*.fixtures.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@jev-cops/sdk": "workspace:*"
  }
}
