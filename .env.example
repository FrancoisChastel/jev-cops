# Semantic-judge API keys (see packages/judge/README.md).
#
# Only the daemon (jevdictd) reads these. It runs outside the agent's sandbox, and the
# sandbox has no route to the judge endpoints (T13). Never export them into an agent's
# environment. A missing key does not stop the daemon: the judge answers "disabled" and
# the daemon runs observe-only on the deterministic floor.

# TypeSafe Jev, judge.provider = "jev" (recommended)
TYPESAFE_API_KEY=

# OpenRouter, judge.provider = "openrouter"
OPENROUTER_API_KEY=
