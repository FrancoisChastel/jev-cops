{
  "name": "@jev-cops/sdk",
  "version": "0.1.0",
  "description": "jev-cops policy SDK: definePolicy, typed judge questions, the fixture format and its runner",
  "keywords": [
    "jev-cops",
    "coding-agents",
    "ai-agents",
    "agent-security",
    "guardrails",
    "bun",
    "policy",
    "sdk",
    "policy-as-code",
    "fixtures"
  ],
  "homepage": "https://github.com/FrancoisChastel/jev-cops#readme",
  "bugs": {
    "url": "https://github.com/FrancoisChastel/jev-cops/issues"
  },
  "license": "Apache-2.0",
  "author": "François Chastel (https://github.com/FrancoisChastel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-cops.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
