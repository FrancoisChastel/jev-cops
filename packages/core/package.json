{
  "name": "@jev-cops/core",
  "version": "0.1.0",
  "description": "jev-cops core: canonical event schema, tree-sitter bash normalizer, context engine and policy engine",
  "keywords": [
    "jev-cops",
    "coding-agents",
    "ai-agents",
    "agent-security",
    "guardrails",
    "bun",
    "policy-engine",
    "bash-parser",
    "tree-sitter"
  ],
  "homepage": "https://github.com/FrancoisChastel/jev-cops#readme",
  "bugs": {
    "url": "https://github.com/FrancoisChastel/jev-cops/issues"
  },
  "license": "Apache-2.0",
  "author": "François Chastel (https://github.com/FrancoisChastel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-cops.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./normalizer": "./src/normalizer/index.ts",
    "./normalizer/tools": "./src/normalizer/tools.ts",
    "./context": "./src/context/index.ts",
    "./judge": "./src/judge/index.ts",
    "./policy": "./src/policy/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "tree-sitter-bash": "0.25.1",
    "ulid": "^3.0.2",
    "web-tree-sitter": "0.27.0",
    "zod": "^4.6.5"
  }
}
