{
  "name": "@jev-cops/openshell",
  "version": "0.1.0",
  "description": "The jev-cops OpenShell compiler: harness protection, task allowlist and judge route as one OpenShell sandbox policy, plus the openshell CLI wrapper",
  "keywords": [
    "jev-cops",
    "coding-agents",
    "ai-agents",
    "agent-security",
    "guardrails",
    "bun",
    "openshell",
    "sandbox",
    "landlock"
  ],
  "homepage": "https://github.com/FrancoisChastel/jev-cops#readme",
  "bugs": {
    "url": "https://github.com/FrancoisChastel/jev-cops/issues"
  },
  "license": "Apache-2.0",
  "author": "François Chastel (https://github.com/FrancoisChastel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-cops.git",
    "directory": "packages/openshell"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@jev-cops/core": "workspace:*",
    "@jev-cops/judge": "workspace:*",
    "@jev-cops/policies": "workspace:*",
    "zod": "^4.6.5"
  }
}
