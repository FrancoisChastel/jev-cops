{
  "name": "@jev-cops/daemon",
  "version": "0.1.0",
  "description": "copsd, the jev-cops judging daemon: Unix sockets and loopback HTTP, SQLite case files, hash-chained JSONL audit log",
  "keywords": [
    "jev-cops",
    "coding-agents",
    "ai-agents",
    "agent-security",
    "guardrails",
    "bun",
    "daemon",
    "audit-log",
    "claude-code"
  ],
  "homepage": "https://github.com/FrancoisChastel/jev-cops#readme",
  "bugs": {
    "url": "https://github.com/FrancoisChastel/jev-cops/issues"
  },
  "license": "Apache-2.0",
  "author": "François Chastel (https://github.com/FrancoisChastel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-cops.git",
    "directory": "packages/daemon"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "copsd": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./claude-code/post": "./src/claude-code/post.ts",
    "./main": "./src/main.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/main.ts"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@jev-cops/core": "workspace:*",
    "@jev-cops/judge": "workspace:*",
    "@jev-cops/policies": "workspace:*",
    "@jev-cops/sdk": "workspace:*",
    "zod": "^4.6.5"
  }
}
