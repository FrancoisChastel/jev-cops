{
  "name": "@jev-cops/daemon",
  "version": "0.0.0",
  "description": "copsd: the jev-cops judging daemon (Unix socket + localhost HTTP, SQLite stores, JSONL audit chain)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
