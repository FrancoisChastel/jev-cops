{
  "name": "@jev-cops/cli",
  "version": "0.1.0",
  "description": "cops, the jev-cops command line: test policies, explain and replay decisions, install and doctor harness hooks",
  "keywords": [
    "jev-cops",
    "coding-agents",
    "ai-agents",
    "agent-security",
    "guardrails",
    "bun",
    "cli",
    "claude-code",
    "pi"
  ],
  "homepage": "https://github.com/FrancoisChastel/jev-cops#readme",
  "bugs": {
    "url": "https://github.com/FrancoisChastel/jev-cops/issues"
  },
  "license": "Apache-2.0",
  "author": "François Chastel (https://github.com/FrancoisChastel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-cops.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cops": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/main.ts"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@jev-cops/adapter-claude-code": "workspace:*",
    "@jev-cops/adapter-pi": "workspace:*",
    "@jev-cops/core": "workspace:*",
    "@jev-cops/daemon": "workspace:*",
    "@jev-cops/sdk": "workspace:*",
    "zod": "^4.6.5"
  }
}
